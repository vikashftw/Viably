# NVIDIA API Configuration
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Serper API Configuration (Google Search)
SERPER_API_KEY=your_serper_api_key_here

# Model Configuration
NEMOTRON_MODEL=nvidia/llama-3.1-nemotron-nano-vl-8b-v1
EMBEDDINGS_MODEL=nvidia/nv-embedqa-e5-v5

# Jira OAuth 2.0 Configuration
JIRA_SERVER=https://your-domain.atlassian.net
JIRA_CLIENT_ID=your_jira_client_id_here
JIRA_CLIENT_SECRET=your_jira_client_secret_here
JIRA_REDIRECT_URI=http://localhost:8000/api/jira/callback

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO